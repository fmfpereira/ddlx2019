<?

// Fmfpereira class is required to use as a node type.
class Fmfpereira {
  function Fmfpereira($fmfpereira) {
    $this = new Node($fmfpereira);
    $this->body = $book[body];
  }
}

// Add text on the admin page
function fmfpereira_help() {
  ?>
  <P><B>FMFPEREIRA HELO</B>: show how to implement the help hook.</P>
  <?
}

// Add available status to the node
function fmfpereira_status() {
  return array(dumped, queued, posted);
}

// Add an entity permission
function fmfpereira_perm() {
  return array("administer fmfpereira");
}

// Display text on the admin page
function fmfpereira_display() {
  print "<P><B>FMFPEREIRA</B>: custom module to show how hooks were implemented in Drupal 3.0</P>";
}

// Add links to the admin / page menus
function fmfpereira_link($type) {
  if ($type == "admin" && user_access("administer fmfpereira")) {
    $links[] = "<a href=\"admin.php?mod=fmfpereira\">fmfpereira</a>";
  }

  if ($type == "page" && user_access("access content")) {
    $links[] = "<a href=\"module.php?mod=fmfpereira\">". t("fmfpereira") ."</a>";
  }

  return $links ? $links : array();
}

// Page router (like a listing page for the public module section)
function fmfpereira_page() {
  global $theme;
  $theme->header();
  $theme->box(t("fmfpereira"), 'Hello world');
  $theme->footer();
}

// Admin router
function fmfpereira_admin() {
  global $op;

  print "<SMALL><A HREF=\"admin.php?mod=fmfpereira&op=help\">help</A></SMALL><HR>\n";

  switch ($op) {
    case "help":
      fmfpereira_help();
      break;
    default:
      fmfpereira_display();
  }
}

// fmfpereira form
// partially implemented
function fmfpereira_form($edit = array()) {
  global $REQUEST_URI, $id, $mod, $type, $user, $theme;
  $form .= form_textfield(t("Subject"), "title", $edit["title"], 50, 64);
  $form .= form_textarea(t("Body"), "body", $edit["body"], 70, 15, t("Allowed HTML tags") .": ". htmlspecialchars(variable_get("allowed_html", "")));
  $form .= form_hidden("type", "blog");
  $form .= form_submit(t("Submit"));
  return form($REQUEST_URI, $form);
}

// node save callback
// partially implemented
function fmfpereira_save($edit) {
  global $status, $user;
  node_save($edit, array(abstract, attributes => node_attributes_save("fmfpereira", $edit), author => $user->id, body, comment => 0, moderate => "", promote => 0, score => 0, status => $status[posted], timestamp => time(), title, type => "fmfpereira", votes => 0));
}

// node view hook
// partially implemented
function fmfpereira_view($node, $main = 0) {
  global $theme;
  $theme->node($node, $main);
}

// node operations hook
// partially implemented
function fmfpereira_user() {
  global $edit, $op, $theme, $user;

  switch($op) {
    case t("Submit"):
      fmfpereira_save($edit);
      $theme->box(t("Submit"), t("Thank you for your submission."));
      break;
    default:
      $theme->box(t("Submit fmfpereira"), fmfpereira_form(), "main");
  }
}

// fmfpereira node insert hook
// add this version, only nodes for the module implementation could be altered.
// this means that other bundles could not be accessed.
// partially implemented
function fmfpereira_insert($node) {

}